{
  "expo": {
    "name": "YAKO",
    "slug": "yako",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bj.yako.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B00",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "bj.yako.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "YAKO a besoin d'accéder à vos photos pour vos documents et votre profil.",
          "cameraPermission": "YAKO a besoin de l'appareil photo pour photographier vos documents."
        }
      ]
    ],
    "scheme": "yako",
    "primaryColor": "#FF6B00",
    "extra": {
      "apiUrl": "http://10.0.2.2:8000/api/v1"
    }
  }
}